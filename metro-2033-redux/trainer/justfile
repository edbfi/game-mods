set shell := ["bash", "-euo", "pipefail", "-c"]
set windows-shell := ["bash", "-euo", "pipefail", "-c"]

target := "x86_64-pc-windows-msvc"
# Cargo builds into the workspace's /target/ unless CARGO_TARGET_DIR moves it.
target_dir := env("CARGO_TARGET_DIR", "../../target")
# Native on Windows; elsewhere cargo-xwin links against the MSVC CRT and SDK pinned by the XWIN_* variables.
cargo_build := if os() == "windows" { "cargo build" } else { "cargo xwin build" }

# List available commands.
default:
    @just --list

# Run the trainer's and the shared crates' tests. On Windows they include the dummy-game backend tests.
test:
    cargo test --locked -p metro-2033-redux-trainer -p edbfi-trainer -p edbfi-tui

# Build build/metro-trainer.exe, version 0.0.0 unless EDBFI_VERSION says otherwise.
build:
    {{cargo_build}} --locked --release --target {{target}} -p metro-2033-redux-trainer
    mkdir -p build
    cp {{quote(target_dir / target / "release/metro-trainer.exe")}} build/

# Show the dashboard against a simulated game, in this terminal.
demo:
    cargo run --locked -p metro-2033-redux-trainer --example demo

# Build the trainer at <version> and zip it, this README and the license as dist/metro-2033-redux-trainer-<version>.zip.
package version:
    [[ {{quote(version)}} =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || { echo "Bad version: "{{quote(version)}} >&2; exit 1; }
    EDBFI_VERSION={{quote(version)}} {{quote(just_executable())}} --justfile {{quote(justfile())}} build
    rm -rf dist/stage dist/metro-2033-redux-trainer-{{version}}.zip
    mkdir -p dist/stage/metro-trainer
    cp build/metro-trainer.exe README.md ../../LICENSE dist/stage/metro-trainer/
    cd dist/stage && python3 -m zipfile -c ../metro-2033-redux-trainer-{{version}}.zip metro-trainer
    rm -rf dist/stage
    echo "Created dist/metro-2033-redux-trainer-{{version}}.zip"

# Remove generated build outputs.
clean:
    rm -rf build dist
