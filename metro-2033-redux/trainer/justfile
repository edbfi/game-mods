export CXX := env("CXX", "g++")
export CPPFLAGS := env("CPPFLAGS", "-Iinclude")
export CXXFLAGS := env("CXXFLAGS", "-std=c++17 -O2 -Wall -Wextra -Wpedantic -Werror")

# List available commands.
default:
    @just --list

# Build and run the portable core, patch-profile and hook tests.
test: test-hooks
    mkdir -p build
    $CXX $CPPFLAGS $CXXFLAGS src/core.cpp tests/core_tests.cpp -o build/core_tests
    $CXX $CPPFLAGS $CXXFLAGS src/core.cpp tests/profile_tests.cpp -o build/profile_tests
    $CXX $CPPFLAGS $CXXFLAGS src/core.cpp src/presentation.cpp tests/presentation_tests.cpp -o build/presentation_tests
    ./build/presentation_tests
    ./build/core_tests
    ./build/profile_tests

# Execute generated hooks against synthetic objects (x86-64 Linux/WSL).
test-hooks:
    mkdir -p build
    $CXX $CPPFLAGS $CXXFLAGS tools/verify-no-reload.cpp -o build/verify-no-reload
    ./build/verify-no-reload
    $CXX $CPPFLAGS $CXXFLAGS tests/conditional_hook_tests.cpp -o build/conditional_hook_tests
    ./build/conditional_hook_tests

# Cross-build build/metro-trainer.exe with Zig 0.17.0.
build:
    ./tools/build-windows.sh

# Run Windows memory-backend and trainer attach tests against disposable processes (WSL only).
test-windows:
    ./tools/test-windows.sh

# Build and zip the trainer as dist/metro-2033-redux-trainer-<version>.zip.
package version: build
    ./tools/package.sh {{quote(version)}}

# Remove generated build outputs.
clean:
    rm -rf build dist
